}

QScrollArea {
	background-color: #081e30;
	border: none;
	border-radius: 10px;
}

QScrollBar::handle:vertical {
    background: #1a3d59;           /* Цвет &quot;ползунка&quot; */
    min-height: 30px;              /* Минимальная высота */
    border-radius: 5px;            /* Скругление краёв */
}

QScrollBar::handle:vertical:hover {
    background: #48647a;      /* Цвет при наведении */
}

QScrollBar:vertical {
    background: #081e30;           /* Цвет фона скроллбара */
    width: 10px;                   /* Толщина скроллбара */
    margin: 0px 0px 0px 0px;       /* Отступы */
    border-radius: 5px;            /* Скругление краёв */
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;              /* Убираем стрелки */
    height: 0px;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;              /* Убираем промежутки */
}</string>
